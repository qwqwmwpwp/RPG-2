+            inventory.CopyItems(items);
+            int bestCount = -1;
+            foreach (RuntimeItem candidate in items)
+            {
+                if (candidate.MagazineState == null || candidate.MagazineState.RoundCount <= bestCount
+                    || candidate.MagazineState.RoundCount == 0
